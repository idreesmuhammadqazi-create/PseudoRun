{
  "name": "pseudorun-monorepo",
  "version": "2.0.0",
  "private": true,
  "description": "PseudoRun monorepo — web app, browser extensions (Firefox/Edge), Windows desktop app, and shared core.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/pseudorun/pseudorun"
  },
  "workspaces": [
    "apps/web",
    "apps/extension-firefox",
    "apps/extension-edge",
    "packages/*",
    "functions"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=@pseudorun/web",
    "build:web": "npm run build --workspace=@pseudorun/web",
    "build:ext:firefox": "npm run build --workspace=@pseudorun/extension-firefox",
    "build:ext:edge": "npm run build --workspace=@pseudorun/extension-edge",
    "build:extensions": "npm run build:ext:firefox && npm run build:ext:edge",
    "build:all": "npm run build:web && npm run build:extensions",
    "build:functions": "npm run build --workspace=functions",
    "typecheck": "npm run -ws --if-present typecheck"
  }
}
