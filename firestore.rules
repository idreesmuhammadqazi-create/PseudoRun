rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Programs collection - only authenticated users can read/write their own
    // Admins can read all programs but cannot write other users' programs
    match /programs/{programId} {
      // Allow read if user owns the program or has admin custom claim
      allow read: if request.auth != null &&
        (request.auth.uid == resource.data.userId ||
         request.auth.token.admin == true);

      // Users can write only their own programs, admins cannot write other users' programs
      allow write: if request.auth != null && request.auth.uid == resource.data.userId;

      // Users can create programs with their own userId
      allow create: if request.auth != null && request.auth.uid == request.resource.data.userId;
    }

    // Users collection - users can read/write own doc; admin can read all
    match /users/{userId} {
      allow read: if request.auth != null &&
        (request.auth.uid == userId || request.auth.token.admin == true);
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    // Analytics - anyone can create visits/sessions/events; only owner can update session; only admin can read
    match /analytics_visits/{docId} {
      allow create: if true;
      allow read: if request.auth != null && request.auth.token.admin == true;
      allow update, delete: if false;
    }
    match /analytics_sessions/{docId} {
      allow create: if true;
      // allow updating own session (match by sessionId param or by anonId/userId stored)
      allow update: if true;
      allow read: if request.auth != null && request.auth.token.admin == true;
      allow delete: if false;
    }
    match /analytics_events/{docId} {
      allow create: if true;
      allow read: if request.auth != null && request.auth.token.admin == true;
      allow update, delete: if false;
    }

    // Shared code collection - authenticated users can create, anyone can read
    match /sharedCode/{shareId} {
      // Anyone can read shared code (for viewing shared links)
      allow read: if true;

      // Authenticated users can create shares
      allow create: if request.auth != null;

      // No updates or deletes allowed
      allow update, delete: if false;
    }

    // Analytics - ad banner stats: anyone can increment views/clicks, admins can read
    match /analytics/adBanner/{adId} {
      allow read: if request.auth != null && request.auth.token.admin == true;
      allow create, update: if true;
      allow delete: if request.auth != null && request.auth.token.admin == true;
    }
    match /analytics/{docId} {
      allow read: if request.auth != null && request.auth.token.admin == true;
      allow create, update: if true;
      allow delete: if request.auth != null && request.auth.token.admin == true;
    }
  }
}
