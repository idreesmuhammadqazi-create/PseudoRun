rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Programs collection - only authenticated users can read/write their own
    // Admins can read all programs but cannot write other users' programs
    match /programs/{programId} {
      // Fallback: Check if request is from admin by email (used when Cloud Functions unavailable)
      // Admin email: idreesmuhammadqazi@gmail.com
      // Note: This is less secure than Custom Claims but works without Cloud Functions deployment
      allow read: if request.auth != null &&
        (request.auth.uid == resource.data.userId ||
         request.auth.token.admin == true ||
         (request.auth.token.email == 'idreesmuhammadqazi@gmail.com' &&
          !request.auth.token.admin)); // Email-based fallback

      // Users can write only their own programs, admins cannot write other users' programs
      allow write: if request.auth != null && request.auth.uid == resource.data.userId;

      // Users can create programs with their own userId
      allow create: if request.auth != null && request.auth.uid == request.resource.data.userId;
    }

    // Shared code collection - authenticated users can create, anyone can read
    match /sharedCode/{shareId} {
      // Anyone can read shared code (for viewing shared links)
      allow read: if true;

      // Authenticated users can create shares
      allow create: if request.auth != null;

      // No updates or deletes allowed
      allow update, delete: if false;
    }
  }
}
