<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <RuntimeIdentifiers>win-x64</RuntimeIdentifiers>
    <Nullable>enable</Nullable>
    <UseWPF>true</UseWPF>
    <!-- MSIX packaging needs an explicit Platform=x64 build, which in turn needs the
         net8.0-windows/win-x64 RID target pre-computed by restore. -->
    <Platforms>AnyCPU;x64</Platforms>
    <!-- Tell the .NET SDK this app is packaged by an EXTERNAL tool (our wapproj),
         not self-packaged. Without this, DesktopBridge's _ConvertItems target
         can't see the csproj output as a package-layout candidate and errors
         with "Project must have a reference to an application". -->
    <WindowsPackageType>None</WindowsPackageType>
    <EnableMsixTooling>true</EnableMsixTooling>
    <!-- <ApplicationIcon>Resources\Icons\app.ico</ApplicationIcon> -->
    <AssemblyName>PseudoRun</AssemblyName>
    <RootNamespace>PseudoRun.Desktop</RootNamespace>
    <Version>1.0.0</Version>
    <Authors>PseudoRun Team</Authors>
    <Company>PseudoRun</Company>
    <Product>PseudoRun Desktop</Product>
    <Description>IGCSE Pseudocode Editor and Simulator for Windows</Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="AvalonEdit" Version="6.3.0" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.2.2" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="8.0.0" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
    <PackageReference Include="PdfSharp" Version="6.0.0" />
    <PackageReference Include="DocumentFormat.OpenXml" Version="3.0.1" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Resources\**\*" />
    <Content Include="Data\**\*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

</Project>
